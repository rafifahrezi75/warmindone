<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- HEADER -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="-25dp"
        app:cardBackgroundColor="#952D03"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.25"
                android:scaleType="centerCrop"
                android:src="@drawable/bgdashboardadmin" />

            <!-- BACK -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/ic_back"/>

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="58dp"
                android:text="Detail Menu"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/montserrat_semibold"/>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- DETAIL MENU -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- TOP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- TEXT -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNamaMenu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="Loading..."
                                android:textColor="#222222"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvKategori"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_medium"
                                android:text="Kategori"
                                android:textColor="#9E9E9E"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvHarga"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text="Rp. 0"
                                android:textColor="#B33A00"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvStok"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stok : 0"
                                android:textColor="#666666"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- IMAGE -->
                        <ImageView
                            android:id="@+id/imgMenu"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:background="@drawable/card_white_menu"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_menu" />

                    </LinearLayout>

                    <!-- DESC -->
                    <TextView
                        android:id="@+id/tvDeskripsi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:lineSpacingExtra="2dp"
                        android:text="Deskripsi menu"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- HEADER ADDON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- TITLE -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_semibold"
                    android:text="Add On"
                    android:textColor="#222222"
                    android:textSize="22sp" />

                <!-- BUTTON PLUS -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnTambahAddon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_plus"
                    app:backgroundTint="#A63600"
                    app:fabCustomSize="50dp"
                    app:tint="@android:color/white"
                    tools:ignore="SpeakableTextPresentCheck" />

            </LinearLayout>

            <!-- RECYCLER ADDON -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAddon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="30dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/addon_widget" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>